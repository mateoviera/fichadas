# Copiá este archivo como ".env.local" y completá los valores.
# Si estas variables quedan vacías, la app funciona sin backend (datos en el navegador).

# Supabase en la nube: Project Settings → API (Project URL y la clave "anon" / "publishable").
# Supabase local: los muestra `npm run db:start` (API URL y anon key / Publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
